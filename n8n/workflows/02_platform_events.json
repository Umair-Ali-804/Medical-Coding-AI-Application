        ]
      ]
    },
    "Signature valid?": {
      "main": [
        [
          {
            "node": "Acknowledge (200)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reject (401)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Acknowledge (200)": {
      "main": [
        [
          {
            "node": "Finalized?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Finalized?": {
      "main": [
        [
          {
            "node": "Fetch final codes",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Needs attention?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch final codes": {
      "main": [
        [
          {
            "node": "Send to billing / EHR bridge",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Needs attention?": {
      "main": [
        [
          {
            "node": "Alert team",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": false
  },
  "pinData": {},
