# =====================================================================
# Medical Coding AI - environment configuration
# Copy to .env and fill in. Generate secrets with:
#   docker compose run --rm api python -m app.cli gen-secrets
# =====================================================================

# --- General ---------------------------------------------------------
ENVIRONMENT=development           # development (your PC) | production (server)
LOG_LEVEL=INFO
LOG_JSON=true
APP_VERSION=latest
CORS_ORIGINS=http://localhost:3000
API_WORKERS=2

# --- Database --------------------------------------------------------
POSTGRES_USER=medcoding
POSTGRES_PASSWORD=change-me-generate-with-gen-secrets
POSTGRES_DB=medcoding

# --- Security (REQUIRED in production) --------------------------------
JWT_SECRET=change-me-64-random-characters
ENCRYPTION_KEYS=change-me-fernet-key   # python -m app.cli gen-secrets
ACCESS_TOKEN_MINUTES=480
LOGIN_RATE_LIMIT_PER_MINUTE=10
MAX_UPLOAD_MB=20
BOOTSTRAP_ADMIN_EMAIL=admin@example.org      # your login email
BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-password

# --- LLM via OpenRouter -----------------------------------------------
LLM_PROVIDER=heuristic            # set to openrouter AND fill OPENROUTER_API_KEY to use the LLM
OPENROUTER_API_KEY=                 # sk-or-... (never commit a real key)
LLM_MODEL=openai/gpt-5.6-luna
LLM_SECONDARY_MODEL=openai/gpt-4o-mini              # optional 2nd model for agreement scoring, e.g. openai/gpt-5
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4000
LLM_TIMEOUT_S=120
LLM_EXTRACTION_ENABLED=true
LLM_PRICE_INPUT_PER_M=3.0         # fallback cost accounting if provider omits usage.cost
LLM_PRICE_OUTPUT_PER_M=15.0

# --- Embeddings / RAG ------------------------------------------------
EMBEDDING_PROVIDER=fastembed      # fastembed (local ONNX, baked into image) | sentence_transformers (GPU) | openai | hash
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
QDRANT_API_KEY=
QDRANT_VERSION=v1.17.0
RETRIEVAL_TOP_K=8

# --- Knowledge base ---------------------------------------------------
ENABLED_CODE_SYSTEMS=ICD-10-CM,ICD-10-PCS,HCPCS   # add CPT only with an AMA CPT license
REFERENCE_DATA_DIR=/reference     # container path of ./data_sources (loaded by `migrate`)
CPT_LICENSE_ACKNOWLEDGED=false    # set true ONLY if your organization holds an AMA CPT license

# --- Confidence / routing ---------------------------------------------
CONFIDENCE_THRESHOLD=0.80         # overridden by CALIBRATION_FILE when present
CALIBRATION_FILE=
ENCOUNTER_TYPE_DEFAULT=outpatient

# --- Integrations (n8n) ------------------------------------------------
WEBHOOK_SECRET=change-me-random
CALLBACK_ALLOWED_HOSTS=n8n        # hosts allowed as per-request callback_url
N8N_VERSION=2.40.5
N8N_DB_USER=n8n
N8N_DB_PASSWORD=change-me-random
N8N_ENCRYPTION_KEY=change-me-random
N8N_PUBLIC_URL=http://localhost:5678/
REVIEW_ALERT_WEBHOOK_URL=         # e.g. Slack/Teams incoming webhook for mandatory-review alerts
DOWNSTREAM_EXPORT_URL=            # optional: where finalized codes are POSTed (billing/EHR bridge)

# --- Worker -----------------------------------------------------------
WORKER_CONCURRENCY=2
WORKER_REPLICAS=1
JOB_MAX_ATTEMPTS=3

# --- Production overlay (Caddy TLS) ------------------------------------
APP_DOMAIN=coding.example.org
N8N_DOMAIN=n8n.example.org
